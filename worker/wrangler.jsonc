{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "workerresponse-secure",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "r2_buckets": [
    {
      "binding": "FLAGS",
      "bucket_name": "workerresponse-flags"
    }
  ],
  "routes": [
    {
      "pattern": "tunnel.greginthecloud.com/secure*",
      "zone_name": "greginthecloud.com"
    }
  ]
}
